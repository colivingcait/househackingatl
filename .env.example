# Copy to .env.local for local dev, and set the same values in the Vercel
# project's Environment Variables for production.

# Kit (ConvertKit) form UIDs — public, not secret. Found in Kit under
# Grow > Landing Pages & Forms > (form) > Embed. Leave unset and the
# signup section is hidden entirely rather than showing a broken form.
NEXT_PUBLIC_KIT_LISTING_ALERTS_FORM_ID=
NEXT_PUBLIC_KIT_NEWSLETTER_FORM_ID=
NEXT_PUBLIC_KIT_RESOURCES_FORM_ID=

# Meta (Facebook) Pixel ID. Leave unset to disable the pixel entirely.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 Measurement ID (e.g. "G-XXXXXXXXXX"). Found under
# GA4 → Admin → Data Streams → (web stream). Leave unset to disable GA4.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
